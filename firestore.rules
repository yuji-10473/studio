
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // For testing purposes, allow anyone to read and write to the debug_writes collection.
    match /debug_writes/{docId} {
      allow read, write: if request.auth != null;
    }

    // For debugging conversations, allow writes to conversations and conversations_errors.
    match /conversations/{docId} {
      allow write: if true;
    }
    match /conversations_errors/{docId} {
      allow write: if true;
    }

    // --- User Profile, States, and History Rules ---
    match /users/{userId} {
      // Allow a user to read and manage their own profile
      allow read, create, update: if request.auth.uid == userId;
    }

    match /users/{userId}/characterStates/{characterId} {
      // Allow a user to read and write their own character states
      allow list, read, write: if request.auth.uid == userId;
    }
    
    // Rules for conversation history
    match /users/{userId}/conversationHistory/{messageId} {
        // Allow a user to read and write their own individual messages
        allow read, write: if request.auth.uid == userId;
    }
    match /users/{userId}/conversationHistory {
        // Allow a user to list their own conversation history
        allow list: if request.auth.uid == userId;
    }


    // --- Admins Rules ---
    // Allow any authenticated user to read the admins collection to check for admin status.
    // Deny all client-side writes for security. Admin status should only be changed from the Firebase Console.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // --- Character Rules ---
    // Allow authenticated users to read and list characters
    match /characters/{characterId} {
      allow read, list: if request.auth != null;
      allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // By default, disallow all other reads and writes.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
