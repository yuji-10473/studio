
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // For testing purposes, allow anyone to read and write to the debug_writes collection.
    match /debug_writes/{docId} {
      allow read, write: if true;
    }

    // For debugging conversations, allow writes to conversations and conversations_errors.
    match /conversations/{docId} {
      allow write: if true;
    }
    match /conversations_errors/{docId} {
      allow write: if true;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      // Allow a user to read their own profile
      allow read: if request.auth.uid == userId;
      // Allow a user to create their own profile, but they cannot make themselves an admin
      allow create: if request.auth.uid == userId && !request.resource.data.isAdmin;
      // Allow a user to update their own profile, but NOT the isAdmin field
      allow update: if request.auth.uid == userId && !("isAdmin" in request.resource.data);
    }
    
    // --- Character Rules ---
    // Allow authenticated users to read characters
    match /characters/{characterId} {
      allow read: if request.auth != null;
    }
    // Allow admins to create, update, and delete characters
    match /characters/{characterId} {
       allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Conversation History Rules ---
    // Allow authenticated users to read and write to conversation history subcollections
    match /characters/{characterId}/conversationHistory/{messageId} {
        allow read, write: if request.auth != null;
    }
    
    // By default, disallow all other reads and writes.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
