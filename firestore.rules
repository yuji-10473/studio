
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // For testing purposes, allow anyone to read and write to the debug_writes collection.
    match /debug_writes/{docId} {
      allow read, write: if true;
    }

    // For debugging conversations, allow writes to conversations and conversations_errors.
    match /conversations/{docId} {
      allow write: if true;
    }
    match /conversations_errors/{docId} {
      allow write: if true;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      // Allow a user to read and manage their own profile
      allow read, create, update: if request.auth.uid == userId;
    }

    // --- Admins Rules ---
    // Deny all client-side reads and writes to the admins collection for security.
    // Admin status should only be changed from the Firebase Console.
    match /admins/{adminId} {
      allow read, write: if false;
    }
    
    // --- Character Rules ---
    // Allow authenticated users to read characters
    match /characters/{characterId} {
      allow read: if true;
    }
    // Allow admins to create, update, and delete characters
    // This rule now checks for the existence of the user's ID in the /admins collection
    match /characters/{characterId} {
       allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // --- Conversation History Rules ---
    // Allow authenticated users to read and write to conversation history subcollections
    match /characters/{characterId}/conversationHistory/{messageId} {
        allow read, write: if request.auth != null;
    }
    
    // By default, disallow all other reads and writes.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
